@page "/connect"

@using System.Collections.ObjectModel
@using ArborFamiliae.Blazor.WinForms.Services
@using ArborFamiliae.Domain.Database
@using ArborFamiliae.Hybrid.Shared.Models
@using ArborFamiliae.Services.Common
@using Microsoft.Data.Sqlite
@using FamilyTreeDatabase = ArborFamiliae.Data.InternalModels.FamilyTreeDatabase
@using ArborFamiliae.Blazor.WinForms.Components.Controls
@inherits BasePageComponent
@layout ConnectLayout

<h3>@Loc["Load family tree"]</h3>

<TwoRowLayout>
    <Row1>
        <DxGrid Data="@Databases"
                KeyFieldName="Name"
                AllowSelectRowByClick="true"
                @bind-SelectedDataItem="@SelectedDataItem"
                SelectionMode="GridSelectionMode.Single">

            <Columns>

                <DxGridDataColumn FieldName="Name"></DxGridDataColumn>
                <DxGridDataColumn FieldName="DatabaseType"></DxGridDataColumn>
            </Columns>

        </DxGrid>
    </Row1>
    <Row2>
        <DxButton RenderStyle="ButtonRenderStyle.Info" Text="@Loc["New family tree"]" Click="NewFamilyTree"></DxButton>
        <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="@Loc["Delete family tree"]" Click="DeleteFamilyTree"></DxButton>
        <DxButton RenderStyle="ButtonRenderStyle.Primary" Click="LoadDatabase" Text="@Loc["Load Family Tree"]"></DxButton>
    </Row2>
</TwoRowLayout>

@{
    
}
<DxPopup @bind-Visible="newTreePopupVisible" HeaderText="@Loc["Add family tree"]" Context="popup_context">
    <BodyTemplate>
        <TwoRowLayout>
            <Row1>
                <EditForm Model="@_addModel" Context="edit_context">
                    <DxFormLayout>
                        <DxFormLayoutGroup Caption="@Loc["Database Type"]">
                            <DxFormLayoutItem>
                                <DxComboBox Data="_databaseTypes"
                                            TextFieldName="Description"
                                            ValueFieldName="Key"
                                            @bind-Value="_addModel.DatabaseType"></DxComboBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Loc["Name"]">
                                <DxTextBox @bind-Text="_addModel.Name"></DxTextBox>
                            </DxFormLayoutItem>
                        </DxFormLayoutGroup>
                        <DxFormLayoutGroup Caption="@Loc["Database parameters"]" Visible="@(_addModel.DatabaseType == "MySql")">
                           
                            <DxFormLayoutItem Caption="@Loc["Server"]">
                                <DxTextBox @bind-Text="_addModel.Server"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Loc["Database"]">
                                <DxTextBox @bind-Text="_addModel.Database"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Loc["Username"]">
                                <DxTextBox @bind-Text="_addModel.Username"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="@Loc["Password"]">
                                <DxTextBox @bind-Text="_addModel.Password"></DxTextBox>
                            </DxFormLayoutItem>
                        </DxFormLayoutGroup>
                        <DxFormLayoutGroup Caption="@Loc["Database parameters"]" Visible="@(_addModel.DatabaseType == "Sqlite")">
                            <DxFormLayoutItem Caption="@Loc["File Path"]" ColSpanMd="12" ColSpanLg="12">
                                <FileSelector @bind-FileName="_addModel.FilePath" ExtensionFilter="Sqlite Files (*.sqlite)|*.sqlite|All Files|*.*"></FileSelector>
                            </DxFormLayoutItem>
                        </DxFormLayoutGroup>
                        
                    </DxFormLayout>
                </EditForm>
            </Row1>
            <Row2>
                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="@Loc["Save"]" Click="Save"></DxButton>
                <DxButton RenderStyle="ButtonRenderStyle.Info" Text="@Loc["Cancel"]" Click="Cancel"></DxButton>
            </Row2>
        </TwoRowLayout>
        
    </BodyTemplate>
</DxPopup>

@code {
    
    
    bool newTreePopupVisible = false;
    private FamilyTreeDatabaseService _databaseService;

    private ObservableCollection<FamilyTreeDatabase> Databases { get; set; }

    private FamilyTreeDatabase _addModel = new FamilyTreeDatabase();

    private List<DatabaseType> _databaseTypes = new List<DatabaseType>();
    
    
    object SelectedDataItem { get; set; }
    
    protected override async Task OnInitializedAsync()
    {
        _databaseService = new FamilyTreeDatabaseService();
        Databases = new ObservableCollection<FamilyTreeDatabase>(_databaseService.LoadDatabases());
        
        
        
        _databaseTypes.Add(new DatabaseType { Key = Provider.MySql.Name, Description = Provider.MySql.Name });
        _databaseTypes.Add(new DatabaseType { Key = Provider.Sqlite.Name, Description = Provider.Sqlite.Name });
        
    }

    private async Task LoadDatabase()
    {
        if (SelectedDataItem == null)
        {
            Snackbar.Add(@Loc["Please select a family tree"], Severity.Error);
            return;
        }
        FamilyTreeDatabase db = SelectedDataItem as FamilyTreeDatabase;
        
        LoadDatabase(db);
    }

    private async Task LoadDatabase(FamilyTreeDatabase db)
    {
        
        if (db.DatabaseType == Provider.MySql.Name)
        {
            var builder = new MySqlConnector.MySqlConnectionStringBuilder();
            builder.Database = db.Database;
            builder.UserID = db.Username;
            builder.Password = db.Password;
            builder.Server = db.Server;

            ConnectionStringService.ConnectionString = builder.ConnectionString;
            ConnectionStringService.Provider = db.DatabaseType;
        }

        if (db.DatabaseType == Provider.Sqlite.Name)
        {
            var builder = new SqliteConnectionStringBuilder();
            builder.DataSource = db.FilePath;

            ConnectionStringService.ConnectionString = builder.ConnectionString;
            ConnectionStringService.Provider = Provider.Sqlite.Name;
        }

        FamilyTreeDatabase.CurrentDatabase = db;
        
        NavigationManager.NavigateTo("/seed", forceLoad: true);
    }

    private void NewFamilyTree()
    {
        newTreePopupVisible = true;
    }

    private async Task Save()
    {
        _databaseService.StoreDatabase(_addModel);
        Databases.Add(_addModel);
        newTreePopupVisible = false;
    }

    private async Task Cancel()
    {
        newTreePopupVisible = false;
        _addModel = new FamilyTreeDatabase();
    }

    private async Task DeleteFamilyTree()
    {
        if (SelectedDataItem == null)
        {
            Snackbar.Add(@Loc["Please select a family tree"], Severity.Error);
            return;
        }
        FamilyTreeDatabase db = SelectedDataItem as FamilyTreeDatabase;
        _databaseService.DeleteDatabase(db);
        Databases.Remove(db);
    }

}