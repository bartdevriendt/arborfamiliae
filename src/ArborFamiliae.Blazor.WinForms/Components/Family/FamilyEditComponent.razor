@using ArborFamiliae.Domain.Family
@using ArborFamiliae.Domain.Events
@using ArborFamiliae.Domain.Person
@using ArborFamiliae.Domain.Enums
@using ArborFamiliae.Blazor.WinForms.Components.Controls

<EditForm Model="@Model" Context="edit_context">
    <TwoRowLayout>
        <Row1>
            <DxFormLayout>
                <DxFormLayoutGroup ColSpanMd="6" Caption="@Loc["Father/partner1"]">
                    <DxFormLayoutItem Caption="@Loc["Name"]" ColSpanMd="12">
                        <PersonSelector Text="@Model.FatherDisplayName" @bind-PersonId="@Model.FatherId" Gender="GenderInternal.Male" PersonSelected="FatherSelected"></PersonSelector>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@Loc["Birth"]" ColSpanMd="12">
                        <DxTextBox @bind-Text="@Model.FatherBirthDate" ReadOnly="true"></DxTextBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@Loc["Death"]" ColSpanMd="12">
                        <DxTextBox @bind-Text="@Model.FatherDeathDate" ReadOnly="true"></DxTextBox>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>
                <DxFormLayoutGroup ColSpanMd="6" Caption="@Loc["Mother/partner2"]">
                    <DxFormLayoutItem Caption="@Loc["Name"]" ColSpanMd="12">
                        <PersonSelector Text="@Model.MotherDisplayName" @bind-PersonId="@Model.MotherId" Gender="GenderInternal.Female" PersonSelected="MotherSelected"></PersonSelector>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@Loc["Birth"]" ColSpanMd="12">
                        <DxTextBox @bind-Text="@Model.MotherBirthDate" ReadOnly="true"></DxTextBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="@Loc["Death"]" ColSpanMd="12">
                        <DxTextBox @bind-Text="@Model.MotherDeathDate" ReadOnly="true"></DxTextBox>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>
                <DxFormLayoutGroup ColSpanMd="12">
                    <DxFormLayoutItem Caption="@Loc["ID"]" ColSpanMd="6">
                        <DxTextBox ReadOnly="true" @bind-Text="@Model.ArborId"></DxTextBox>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>

                <DxTabs>
                    <DxTabPage Text="@Loc["Children"]">
                        <TwoRowLayout>
                            <Row1>
                                <DxToolbar>
                                    <Items>
                                        <DxToolbarItem Text="@Loc["Add"]" IconCssClass="bi bi-plus" Click="OnChildLink"></DxToolbarItem>
                                        <DxToolbarItem Text="@Loc["Delete"]" IconCssClass="bi bi-trash" Click="OnDeleteChild"></DxToolbarItem>
                                    </Items>
                                </DxToolbar>
                            </Row1>
                            <Row2>
                                <DxGrid @ref="_childGrid" 
                                        Data="@Model.Children"
                                        KeyFieldName="ArborId"
                                        AllowSelectRowByClick="true"
                                        SelectionMode="GridSelectionMode.Single"
                                        @bind-SelectedDataItem="_selectedChild"
                                        >
                                    <Columns>
                                        <DxGridDataColumn Caption="@Loc["Order"]" FieldName="Order"></DxGridDataColumn>
                                        <DxGridDataColumn Caption="@Loc["ID"]" FieldName="ArborId"></DxGridDataColumn>
                                        <DxGridDataColumn Caption="@Loc["Name"]" FieldName="Name"></DxGridDataColumn>
                                        <DxGridDataColumn Caption="@Loc["Gender"]" FieldName="Gender"></DxGridDataColumn>
                                        <DxGridDataColumn Caption="@Loc["Paternal"]" FieldName="PaternalRelation"></DxGridDataColumn>
                                        <DxGridDataColumn Caption="@Loc["Maternal"]" FieldName="MaternalRelation"></DxGridDataColumn>
                                        <DxGridDataColumn Caption="@Loc["BirthDate"]" FieldName="BirthDate"></DxGridDataColumn>
                                    </Columns>   
                                </DxGrid>
                            </Row2>
                        </TwoRowLayout>
                    </DxTabPage>
                </DxTabs>
                
                @* <SfTab> *@
                @*     <TabItems> *@
                @*         <TabItem> *@
                @*             <ChildContent> *@
                @*                 <TabHeader Text="@Loc["Children"]"></TabHeader> *@
