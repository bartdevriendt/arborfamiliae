@using MudBlazor
@inherits LayoutComponentBase


<MudThemeProvider Theme="_currentTheme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider/>



<MudLayout>
    <MudAppBar Elevation="25">
        <MudText Typo="Typo.h6" Class="ml-4">Arbor Familiae</MudText>
        <MudToolBar DisableGutters="true">
            <MudIconButton Icon="@Icons.Material.Outlined.Menu" Color="Color.Inherit" OnClick="@((e) => DrawerToggle())" Class="ml-3" />
        </MudToolBar>
        <MudSpacer />
        <MudMenu AnchorOrigin="Origin.TopRight" Dense="true" Class="mt-1 ml-4">
            <ActivatorContent>
                <MudAvatar Color="Color.Secondary">BD</MudAvatar>
            </ActivatorContent>
            <ChildContent>
                @* <MudListItem Text="Accounts" Icon="@Icons.Material.Filled.AccountBox" OnClick="Accounts" T="string" /> *@
                @* <MudListItem Text="Profile" Icon="@Icons.Material.Filled.Person" OnClick="Profile" T="string"  /> *@
                @* <MudListItem Text="Logout" Icon="@Icons.Material.Filled.Logout" OnClick="BeginSignOut" T="string"  /> *@
            </ChildContent>
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="25" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer>
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

