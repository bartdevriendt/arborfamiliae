@page "/"
@page "/databaseselection"
@using ArborFamiliae.CrossPlatform.Shared.Layout
@using ArborFamiliae.Data.InternalModels
@layout DatabaseSelectionLayout

@inject NavigationManager NavigationManager

<h1>Database Selection</h1>

<p>Please select a database to use</p>

<SfGrid DataSource="@databases">
    
    <GridEvents OnRecordDoubleClick="DatabaseRecordDoubleClick" TValue="FamilyTreeDatabase"></GridEvents>
    <GridColumns>
        <GridColumn Field="@nameof(FamilyTreeDatabase.Name)"></GridColumn>
        <GridColumn Field="@nameof(FamilyTreeDatabase.DatabaseType)"></GridColumn>
    </GridColumns>
</SfGrid>


<NavLink href="/home">Home</NavLink>>

@code {

