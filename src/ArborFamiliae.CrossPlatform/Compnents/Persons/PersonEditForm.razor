@using ArborFamiliae.Domain.Person
@using ArborFamiliae.Domain.Events
@inject IGenderService GenderService

<SfDataForm ID="EditPerson" Model="@Model" ColumnCount="1">

    <FormValidator>
        <DataAnnotationsValidator></DataAnnotationsValidator>
    </FormValidator>

    <FormItems>
        <FormGroup LabelText="@Loc["Preferred"]" ColumnCount="12" ColumnSpacing="10px">
            <FormItem Field="@nameof(PersonAddEditModel.PreferredTitle)" LabelText="@Loc["Title"]" ColumnSpan="4"></FormItem>
            <FormItem Field="@nameof(PersonAddEditModel.PreferredNick)" LabelText="@Loc["Nick"]" ColumnSpan="4"></FormItem>
            <FormItem Field="@nameof(PersonAddEditModel.PreferredCall)" LabelText="@Loc["Call"]" ColumnSpan="4"></FormItem>
            <FormItem Field="@nameof(PersonAddEditModel.PreferredGivenName)" LabelText="@Loc["Given"]" ColumnSpan="8"></FormItem>
            <FormItem Field="@nameof(PersonAddEditModel.PreferredSuffix)" LabelText="@Loc["Suffix"]" ColumnSpan="4"></FormItem>
            <FormItem Field="@nameof(PersonAddEditModel.PreferredSurnamePrefix)" LabelText="@Loc["Surname"]" ColumnSpan="4"></FormItem>
            <FormItem Field="@nameof(PersonAddEditModel.PreferredSurname)" LabelText="&nbsp;" ColumnSpan="4"></FormItem>
        </FormGroup>
        <FormGroup LabelText="@Loc["General"]" ColumnCount="12" ColumnSpacing="10px">
            <FormItem Field="@nameof(PersonAddEditModel.Gender)" ColumnSpan="4">
                <Template>
                    <label>@Loc["Gender"]</label>
                    <SfComboBox DataSource="_genders" TItem="GenderModel" TValue="Guid" @bind-Value="@Model.Gender"
                                Placeholder="@Loc["Select Gender"]">
                        <ComboBoxFieldSettings Text="Description" Value="Id"></ComboBoxFieldSettings>
                    </SfComboBox>
                </Template>
            </FormItem>
            <FormItem Field="@nameof(PersonAddEditModel.ArborId)" LabelText="ID" ColumnSpan="4"></FormItem>
        </FormGroup>
    </FormItems>
    @if (IsEdit)
    {
        <SfTab>
            <TabItems>
                <TabItem>
                    <ChildContent>
                        <TabHeader Text="@Loc["Events"]"></TabHeader>
                    </ChildContent>
                    <ContentTemplate>
                        @* <NestedEventList @bind-Events="Model.Events" EventMode="NestedEventList.EventListMode.Person" EventDeleted="OnEventDeleted"></NestedEventList> *@
                    </ContentTemplate>
                </TabItem>
            </TabItems>
        </SfTab>
    }

    <FormButtons>
        <SfButton IsPrimary="true" @onclick="OnSave">@Loc["Save"]</SfButton>
    </FormButtons>
</SfDataForm>

